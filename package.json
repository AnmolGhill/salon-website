{
  "name": "salon-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "node --disable-warning=ExperimentalWarning scripts/check-booking.mjs",
    "pages:dev": "wrangler pages dev -- npm run dev",
    "db:local": "wrangler d1 execute salon-bookings --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute salon-bookings --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.6"
  }
}
